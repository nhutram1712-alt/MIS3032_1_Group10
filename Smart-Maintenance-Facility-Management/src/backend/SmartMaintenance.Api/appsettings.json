{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SmartMaintenanceDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Secret": "DEV_ONLY_CHANGE_ME_SmartMaintenance_Jwt_Secret_Key_32+",
    "Issuer": "SmartMaintenance",
    "Audience": "SmartMaintenance",
    "ExpiresMinutes": "480"
  },
  "Iot": {
    "GatewayApiKey": "DEV_ONLY_IOT_GATEWAY_KEY",
    "IntervalMinutes": 5
  },
  "Ai": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "DEV_ONLY_AI_SERVICE_KEY",
    "TimeoutSeconds": 5,
    "BackgroundJobEnabled": false,
    "JobIntervalHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
